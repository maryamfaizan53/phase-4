
# Database Configuration
# Replace with your actual Neon PostgreSQL connection string
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/database?sslmode=require&channel_binding=require

# OpenAI / OpenRouter API Keys
# Get your keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - OpenRouter: https://openrouter.ai/keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.0-flash-exp:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Better Auth / JWT Configuration
# Generate a secure random key with: openssl rand -hex 32
# NEW GENERATED KEY (replace the one in your actual .env):
JWT_SECRET_KEY=017d87e04636f5927369c66721a80fb136036f70e6c8989fd5081135b3a169d8
JWT_ALGORITHM=HS256
AUTH_AUTO_CREATE_USERS=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT=100/minute
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
ENV=development
DEBUG=true
